# API 서버
PORT=3000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://shorts:shorts@localhost:5432/shorts
STORAGE_ROOT=./storage-data
# 다운로드/썸네일 서명 URL용 시크릿 (운영에서는 반드시 무작위 값으로 설정)
FILE_TOKEN_SECRET=change-me

# 워커 헬스체크 포트
HEALTH_PORT=8081

# 분석 워커
WHISPER_MODEL=base
WHISPER_CACHE=./models
SCORING_CONFIG=./config/scoring.yaml

# 스토리지 드라이버 (local | s3)
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3일 때:
# S3_BUCKET=shorts-editor
# S3_ENDPOINT=            # S3 호환 스토리지(MinIO 등)일 때만
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# 워커 동시 처리 개수 (스케일아웃: docker compose up --scale worker-render=3)
WORKER_CONCURRENCY=1

# 금칙어 목록 (F-14-R3)
BANNED_WORDS=./config/banned-words.json
