      "segments": [
        {
          "start": 2,
          "end": 30,
          "text": "밝고 안정적인 도입부 발화이며 내용이 좋습니다 그리고 계속됩니다",
          "words": [
            {
              "start": 2,
              "end": 5.5,
              "text": "밝고"
            },
            {
              "start": 5.5,
              "end": 9,
              "text": "안정적인"
            },
            {
              "start": 9,
              "end": 12.5,
              "text": "도입부"
            },
            {
              "start": 12.5,
              "end": 16,
              "text": "발화이며"
            },
            {
              "start": 16,
              "end": 19.5,
              "text": "내용이"
            },
            {
              "start": 19.5,
              "end": 23,
              "text": "좋습니다"
            },
            {
              "start": 23,
              "end": 26.5,
              "text": "그리고"
            },
            {
              "start": 26.5,
              "end": 30,
              "text": "계속됩니다"
            }
          ]
        },
        {
          "start": 40,
          "end": 60,
          "text": "어둡고 흔들리는 구간의 발화입니다",
          "words": [
            {
              "start": 40,
              "end": 45,
              "text": "어둡고"
            },
            {
              "start": 45,
              "end": 50,
              "text": "흔들리는"
            },
            {
              "start": 50,
              "end": 55,
              "text": "구간의"
            },
            {
              "start": 55,
              "end": 60,
              "text": "발화입니다"
            }
          ]
        },
        {
          "start": 68,
          "end": 96,
          "text": "다시 밝아진 마무리 발화이며 결론을 말합니다 끝까지 봐주세요",
          "words": [
            {
              "start": 68,
              "end": 71.5,
              "text": "다시"
            },
            {
              "start": 71.5,
              "end": 75,
              "text": "밝아진"
            },
            {
              "start": 75,
              "end": 78.5,
              "text": "마무리"
            },
            {
              "start": 78.5,
              "end": 82,
              "text": "발화이며"
            },
            {
              "start": 82,
              "end": 85.5,
              "text": "결론을"
            },
            {
              "start": 85.5,
              "end": 89,
              "text": "말합니다"
            },
            {
              "start": 89,
              "end": 92.5,
