{
  "name": "@shorts/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@shorts/db": "workspace:*",
    "@shorts/media": "workspace:*",
    "@shorts/queue": "workspace:*",
    "@shorts/shared": "workspace:*",
    "@shorts/storage": "workspace:*",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
